#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To1_macro_A: To1_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To1_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro_A: To2_macro_A {
            compatible = "zmk,behavior-macro";
            label = "To2_macro_A";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(250,100,50) &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(250,100,50) &to 0>;
        };

        PASSWORD: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N8 &kp N5 &kp N0 &kp N6 &kp N0 &kp N4 &kp X &kp X &kp Z &kp J &kp J &kp S &kp S>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &mt F1 N1    &kp N2       &kp N3       &kp N4       &kp N5      &kp NUMBER_6  &kp N7         &kp N8     &kp N9   &kp N0    &kp DEL
&mt CAPS TAB    &mt LG(Q) Q  &mt LG(W) W  &kp E        &kp R        &kp T       &kp Y         &kp U          &kp I      &kp O    &kp P     &kp BSLH
&kp LEFT_SHIFT  &mt LG(A) A  &mt LG(S) S  &kp D        &mt LG(F) F  &kp G       &kp H         &kp J          &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL       &mt LG(Z) Z  &mt LG(X) X  &mt LG(C) C  &mt LG(V) V  &kp B       &kp N         &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RALT
                                          &kp LMETA    &kp SPACE    &to 1       &to 2         &kp BACKSPACE
                                                       &mkp MB1     &mkp MB2    &kp ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp F12    &kp F1                             &kp F2          &kp F3                                  &kp F4            &kp F5               &kp F6       &kp F7           &kp F8         &kp F9           &kp F10    &kp F11
&kp CAPS   &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &msc SCRL_UP    &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &kp K_PREV        &kp C_VOL_UP         &kp HOME     &kp UP_ARROW     &kp END        &kp PRINTSCREEN  &kp MINUS  &kp EQUAL
&kp LSHFT  &msc SCRL_LEFT                     &msc SCRL_DOWN  &msc SCRL_RIGHT                         &kp K_PLAY_PAUSE  &kp K_MUTE           &kp LEFT     &kp DOWN         &kp RIGHT      &kp SLCK         &kp LBKT   &kp RBKT
&PASSWORD  &kp K_COPY                         &kp K_CUT       &kp K_PASTE                             &kp K_NEXT        &kp C_VOLUME_DOWN    &kp PAGE_UP  &kp PRINTSCREEN  &kp PAGE_DOWN  &kp INS          &kp F4     &kp GRAVE
                                                              &kp K_UNDO                              &mkp MB3          &to 0                &to 2        &kp BSPC
                                                                                                      &mkp MB1          &mkp MB2             &kp ENTER
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &PASSWORD         &kp N7     &kp N8         &kp N9     &kp PLUS   &msc SCRL_LEFT   &kp DELETE
&bt BT_SEL 1  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &msc SCRL_UP     &kp UP_ARROW     &msc SCRL_DOWN    &kp N4     &kp N5         &kp N6     &kp MINUS  &msc SCRL_RIGHT  &kp TAB
&bt BT_SEL 2  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &kp LEFT         &kp DOWN_ARROW   &kp RIGHT         &kp N1     &kp N2         &kp N3     &kp ASTRK  &kp EQUAL        &kp RSHFT
&bt BT_SEL 3  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp LG(X)        &kp LG(C)        &kp LG(V)         &kp N0     &kp DOT        &kp COMMA  &kp FSLH   &kp RALT         &kp RCTRL
                                                &kp TAB          &kp SPACE        &to 1             &to 0      &kp BACKSPACE
                                                                 &mkp MB1         &mkp MB2          &kp ENTER
            >;
        };

        /* layer_3 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
